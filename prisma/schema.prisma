generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  DRAFT
  PUBLISHED
}

enum Animal {
  HUND
  KATZE
}

enum FoodType {
  ALLEIN
  ERGAENZUNG
}

enum PriceClass {
  GUENSTIG
  MITTEL
  PREMIUM
}

enum Bewertungsart {
  ALLEINFUTTER
  ERGAENZUNGSFUTTER
}

enum EfSicherheit {
  OK
  MITTEL
  SCHWER
}

enum EfStudienTier {
  HUND
  KATZE
  ANDERE_TIERART
  MENSCH
  IN_VITRO
}

enum EfEvidenz {
  META_ANALYSE
  SYSTEMATISCHES_REVIEW
  RCT
  KONTROLLIERT_NICHT_RANDOMISIERT
  BEOBACHTUNG
  FALLBERICHT
  IN_VITRO
  EXPERTENMEINUNG
}

enum EfRichtung {
  POSITIV
  KEIN_EFFEKT
  NEGATIV
  GEMISCHT
}

enum EfDosisEinheit {
  MG
  G
  KBE
  MG_KG_075
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  shortName   String
  description String
  animal      Animal
  foodType    FoodType
  sortOrder   Int      @default(0)
  reviews     Review[]
}

model Review {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  brand       String
  productName String
  keyword     String     @default("")
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id])
  priceClass  PriceClass @default(MITTEL)
  pricePerKg  Decimal?   @db.Decimal(8, 2)

  imageUrl  String?
  imageAlt  String  @default("")
  imageBlur String?
  /// Bild 2: das Produkt selbst (Kroketten, Brocken, Tropfen …)
  contentImageUrl  String?
  contentImageAlt  String  @default("")
  contentImageBlur String?
  /// weitere Produktbilder (URLs)
  gallery   String[] @default([])

  // Produktdaten
  /// Zusammensetzung wie auf dem Etikett (kommagetrennt)
  composition String    @default("")
  /// [{ "name": "Rohprotein", "value": 10.5 }] – Angaben in %
  analysis    Json      @default("[]")
  packageSize String    @default("")
  price       Decimal?  @db.Decimal(8, 2)
  pricePerDay Decimal?  @db.Decimal(8, 2)
  priceDate   DateTime?
  testedAt    DateTime?
  /// [{ "claim", "rating": ZULAESSIG|FRAGWUERDIG|UNZULAESSIG, "reason", "legal", "imageUrl" }]
  claims      Json      @default("[]")

  // Bewertung (Maxima siehe src/lib/scoring.ts)
  scoreRaw         Int @default(0)
  scoreHarmful     Int @default(0)
  scoreNutrients   Int @default(0)
  scoreDeclaration Int @default(0)
  scoreNeeds       Int @default(0)
  scoreValue       Int @default(0)
  totalScore       Int @default(0)

  verdict  String   @default("")
  /// Reißerischer Anreißer für die Vorschau-Karte (max. 100 Zeichen, drei Zeilen)
  teaser   String   @default("")
  /// Kurzbegründung für das Schadstoff-Warnsignal
  harmfulReason String @default("")
  pros     String[] @default([])
  cons     String[] @default([])
  bodyHtml String   @default("")
  /// Ausführliches Fazit (HTML), eigener Abschnitt am Ende des Testtexts
  conclusionHtml String @default("")

  metaTitle       String   @default("")
  metaDescription String   @default("")
  keywords        String[] @default([])
  /// Slug aus src/lib/authors.ts. Leer = Standardautor.
  authorSlug  String?

  /// Leer = bisheriges Layout. "TESTVORLAGE_V2" aktiviert die feste Testvorlage (Inhalte in layoutData).
  layout     String @default("")
  /// Strukturierte Inhalte der Testvorlage, Schema siehe docs/testvorlage-v2.md. Ungültig = Rückfall auf das bisherige Layout.
  layoutData Json?

  /// Bestehende Tests bleiben Alleinfutter. Die ef-Felder zählen nur bei ERGAENZUNGSFUTTER.
  bewertungsart   Bewertungsart @default(ALLEINFUTTER)
  methodikVersion String        @default("")

  efWirkstoffAuswahl                Int?
  efWirkstoffAuswahlBegruendung     String       @default("")
  efWirkstoffDosierung              Int?
  efWirkstoffDosierungBegruendung   String       @default("")
  efWerbung                         Int?
  efWerbungBegruendung              String       @default("")
  efTraeger                         Int?
  efTraegerBegruendung              String       @default("")
  efTransparenzMengen               Int?
  efTransparenzMengenBegruendung    String       @default("")
  efTransparenzUnterlagen           Int?
  efTransparenzUnterlagenBegruendung String      @default("")
  efAlibiDosierung                  Boolean      @default(false)
  efKeineReferenzdosis              Boolean      @default(false)
  efHeilaussage                     Boolean      @default(false)
  efSicherheit                      EfSicherheit @default(OK)
  efSicherheitBegruendung           String       @default("")
  efTierschutzText                  String       @default("")
  efTraegerAbzuege                  String[]     @default([])
  efPreisTagesdosisEur              Decimal?     @db.Decimal(8, 2)

  wirkstoffe ErgaenzungWirkstoff[]
  studien    ErgaenzungStudie[]

  status      Status    @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  productOfMonth ProductOfMonth[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

model ErgaenzungWirkstoff {
  id                     String   @id @default(cuid())
  reviewId               String
  review                 Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  name                   String
  mengeMgProTagesdosis   Decimal? @db.Decimal(12, 3)
  referenzMgProKg        Decimal? @db.Decimal(12, 3)
  sortOrder              Int      @default(0)
  studien                ErgaenzungStudie[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([reviewId])
}

model ErgaenzungStudie {
  id                   String          @id @default(cuid())
  reviewId             String
  review               Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  wirkstoffId          String
  wirkstoff            ErgaenzungWirkstoff @relation(fields: [wirkstoffId], references: [id], onDelete: Cascade)
  titel                String
  autoren              String
  jahr                 Int
  zeitschrift          String          @default("")
  tierart              EfStudienTier
  studiendosisJeKg     Decimal?        @db.Decimal(14, 4)
  einheit              EfDosisEinheit?
  studiendosisOriginal String          @default("")
  ergebnisKurz         String
  link                 String
  linkFreigabe         Boolean         @default(false)
  evidenzstufe         EfEvidenz
  richtung             EfRichtung
  geprueftAm           DateTime
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([reviewId])
  @@index([wirkstoffId])
}

model Referenzdosis {
  id          String   @id @default(cuid())
  wirkstoff   String
  tierart     Animal
  mgProKgMin  Decimal? @db.Decimal(14, 4)
  mgProKgMax  Decimal? @db.Decimal(14, 4)
  einheit     String   @default("mg/kg")
  quelle      String
  luecke      Boolean  @default(false)
  stand       DateTime
  hinweis     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([wirkstoff, tierart])
}

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String    @default("")
  bodyHtml        String    @default("")
  imageUrl        String?
  imageAlt        String    @default("")
  imageBlur       String?
  metaTitle       String    @default("")
  metaDescription String    @default("")
  keywords        String[]  @default([])
  /// Slug aus src/lib/authors.ts. Leer = Standardautor.
  authorSlug      String?
  status          Status    @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
}

model ProductOfMonth {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reason    String
  createdAt DateTime @default(now())

  @@unique([year, month])
}

model TickerItem {
  id        String    @id @default(cuid())
  text      String
  href      String?
  isWarning Boolean   @default(false)
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  createdAt DateTime @default(now())
}

model FaqItem {
  id        String @id @default(cuid())
  question  String
  answer    String
  sortOrder Int    @default(0)
}

model ContactMessage {
  id        String   @id @default(cuid())
  kind      String
  name      String
  email     String
  company   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

enum Concern {
  UNBEDENKLICH
  EINGESCHRAENKT
  BEDENKLICH
}

model LexikonEntry {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  synonyms         String[]  @default([])
  group            String    @default("")
  concern          Concern   @default(UNBEDENKLICH)
  shortDescription String    @default("")
  assessment       String    @default("")
  bodyHtml         String    @default("")
  metaTitle        String    @default("")
  metaDescription  String    @default("")
  status           Status    @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

model GlossaryTerm {
  id         String   @id @default(cuid())
  slug       String   @unique
  term       String
  synonyms   String[] @default([])
  definition String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Pseudonymer Zähler „Gäste online“ (nur nach Einwilligung): zufällige Kennung je Browser und Zeitpunkt der letzten Meldung, keine IP, kein Cookie. Einträge werden nach spätestens zehn Minuten gelöscht.
model LiveVisitor {
  id     String   @id
  seenAt DateTime @default(now())

  @@index([seenAt])
}
