# Pflicht – Supabase (Rolle "prisma"; Host aus Supabase → Connect → Session/Transaction pooler)
DATABASE_URL="postgres://prisma.PROJECT_REF:PASSWORT@aws-X-eu-central-1.pooler.supabase.com:6543/postgres"   # Laufzeit (Transaction)
DIRECT_URL="postgres://prisma.PROJECT_REF:PASSWORT@aws-X-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"   # Migrationen (Session)
AUTH_SECRET=""                     # openssl rand -base64 32
NEXT_PUBLIC_SITE_URL="https://futterpruefer.de"

# Nur für den Seed (erstes Admin-Konto)
ADMIN_EMAIL="admin@futterpruefer.de"
ADMIN_PASSWORD=""                  # min. 12 Zeichen

# Bild-Upload (nur Server, nie im Browser). Öffentlicher Bucket „bilder“.
SUPABASE_URL="https://cotopvhmsqztjtdsdnoc.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""       # sb_secret…; als apikey und Authorization, nicht loggen

# Optional – Funktionen schalten sich automatisch zu, sobald gesetzt
ANTHROPIC_API_KEY=""               # „Meta/Keywords generieren“
RESEND_API_KEY=""                  # Kontaktformular per E-Mail
CONTACT_TO_EMAIL=""                # optional; Standard: bernhardehmer@gmail.com
CONTACT_FROM_EMAIL=""              # optional; Standard: onboarding@resend.dev (bis eine Domain bei Resend verifiziert ist)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""  # Cloudflare Turnstile
TURNSTILE_SECRET_KEY=""

# Newsletter (Brevo Double-Opt-In) – ohne Werte zeigt das Formular „wird gerade eingerichtet“
BREVO_API_KEY=""
BREVO_LIST_ID=""
BREVO_DOI_TEMPLATE_ID=""
